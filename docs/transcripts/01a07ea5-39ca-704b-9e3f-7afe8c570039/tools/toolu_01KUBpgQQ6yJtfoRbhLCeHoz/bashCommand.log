vite.config.ts
version: "1"
projects:
  - name: gatherus
    environments:
      - name: Production
        services:
          - type: web
            name: gatherus
            runtime: static
            repo: https://github.com/dlants/gatherus
            buildCommand: npm ci && npm run build
            staticPublishPath: packages/frontend/dist
            domains:
              - www.gatherus.xyz
              - gatherus.xyz
            routes:
              - type: rewrite
                source: /api/*
                destination: https://gatherus-api.onrender.com/api/*
              - type: rewrite
                source: /*
                destination: /index.html
            autoDeployTrigger: commit
          - type: web
            name: gatherus-api
            runtime: docker
            repo: https://github.com/dlants/gatherus
            plan: starter
            dockerfilePath: ./docker/Dockerfile
            dockerContext: .
            envVars:
              # Meili is co-hosted in the container (docker/entrypoint.sh),
              # reached on localhost. Read explicitly by packages/backend/env.ts.
              - key: PORT
                value: "3000"
              - key: MEILI_URL
                value: http://localhost:7700
              - key: MEILI_INDEX_NAMESPACE
                value: prod
              - key: MEILI_MASTER_KEY
                generateValue: true
              - key: FROM_EMAIL
                sync: false
              - key: RESEND_API_KEY
                sync: false
              - key: GOOGLE_CLIENT_SECRET
                sync: false
              - key: GOOGLE_CLIENT_ID
                sync: false
              - key: BETTER_AUTH_SECRET
                sync: false
              - key: BETTER_AUTH_URL
                sync: false
              - key: BASE_URL
                sync: false
              - key: DATABASE_URL
                fromDatabase:
                  name: gatherus-prod
                  property: connectionString
              - key: RELEASE_STAGE
                sync: false
            region: oregon
            preDeployCommand: npm -w @gatherus/backend run migrate:prod
            autoDeployTrigger: commit
        databases:
          - name: gatherus-prod
            databaseName: gatherus_prod
            user: gatherus_prod_user
            plan: basic-256mb
            region: oregon
            ipAllowList:
              - source: 0.0.0.0/0
                description: everywhere
            postgresMajorVersion: "18"
            diskSizeGB: 1
