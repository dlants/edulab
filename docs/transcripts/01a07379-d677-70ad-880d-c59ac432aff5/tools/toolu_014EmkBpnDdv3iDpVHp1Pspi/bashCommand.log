  bodyRect: body.getBoundingClientRect().height,
  bodyScroll: body.scrollHeight,
  paneRect: body.firstElementChild.getBoundingClientRect().height,
  msgs: msgs.map(m => ({over: m.dataset.overflowing, clipped: m.dataset.clipped, h: Math.round(m.getBoundingClientRect().height)})).slice(0,6),
});
endeval
