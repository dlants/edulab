export function show<ChildState, ChildMsg, ChildCtx>(
  ViewClass: ViewCtor<ChildState, ChildMsg, ChildCtx>,
  state: ChildState,
  ctx: ChildCtx,
  childDispatch: (childMsg: ChildMsg) => void,
  key?: string,
): SlotContent {
  return {
    key,
    ctor: ViewClass,
    state,
    ctx,
    childDispatch,
  } as unknown as SlotContent;
}
