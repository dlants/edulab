{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules"]
}
import { allocFreePort } from "@gatherus/test/src/index.ts";
import { defineConfig } from "@playwright/test";
const backendPort = process.env.TEST_BACKEND_PORT
  ? Number(process.env.TEST_BACKEND_PORT)
  : await allocFreePort();
const frontendPort = process.env.TEST_FRONTEND_PORT
  ? Number(process.env.TEST_FRONTEND_PORT)
  : await allocFreePort();
const browserOrigin =
  process.env.TEST_BROWSER_ORIGIN ?? `http://localhost:${frontendPort}`;
const backendUrl =
  process.env.TEST_BACKEND_URL ?? `http://127.0.0.1:${backendPort}`;
const dbName = `gatherus_test_${backendPort}`;
const databaseUrl =
  process.env.TEST_DATABASE_URL ??
  `postgres://gatherus:gatherus@localhost:5432/${dbName}`;
process.env.TEST_BACKEND_PORT = String(backendPort);
process.env.TEST_FRONTEND_PORT = String(frontendPort);
process.env.TEST_BROWSER_ORIGIN = browserOrigin;
process.env.TEST_BACKEND_URL = backendUrl;
process.env.TEST_DATABASE_URL = databaseUrl;
export default defineConfig({
  testDir: "./tests",
  fullyParallel: true,
  workers: 4,
  timeout: 30_000,
  expect: {
    timeout: 2_000,
  },
  use: {
    baseURL: browserOrigin,
    actionTimeout: 2_000,
    navigationTimeout: 5_000,
  },
  webServer: [
    {
      command: "node src/test-server.ts",
      env: {
        TEST_BACKEND_PORT: String(backendPort),
        TEST_FRONTEND_PORT: String(frontendPort),
        TEST_BROWSER_ORIGIN: browserOrigin,
      },
      port: backendPort,
      reuseExistingServer: false,
      timeout: 60_000,
    },
    {
      command: "vite",
      cwd: "../..",
      env: {
        VITE_PORT: String(frontendPort),
        VITE_TEST_MODE: "1",
        API_TARGET: backendUrl,
      },
      port: frontendPort,
      reuseExistingServer: false,
      timeout: 60_000,
    },
  ],
});
