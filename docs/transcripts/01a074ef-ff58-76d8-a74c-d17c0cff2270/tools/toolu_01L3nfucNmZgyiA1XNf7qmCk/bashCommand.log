44:export type ToolCall = {
45-  id: string;
46-  name: string;
47-  /** Parsed from the streamed json; undefined while still streaming or if it
48-   * never parsed. */
49-  input: Record<string, unknown> | undefined;
50-  /** Raw accumulated json, so a partial call is still renderable. */
51-  inputJson: string;
52-  /** Derived from the paired tool_result block in the next user turn; absent
53-   * while the tool is still running. */
54-  result: ToolResult | undefined;
55-};
56-
57-export type YieldValue =
58-  | { type: "text"; text: string }
59-  | { type: "structured"; value: Record<string, unknown> };
60-
61-export type TurnResult =
62-  | { type: "completed" }
63-  | { type: "yielded"; value: YieldValue }
64-  | { type: "error"; message: string };
65-
66-export type ThreadOpts = {
67-  system?: string;
68-  /** Sent after the seed, and rendered: a learning thread's opening ask is
69-   * one of these, not part of the seed. */
--
103:export type Message =
104-  | { type: "text"; role: "user" | "assistant"; text: string }
105-  | { type: "tool_use"; role: "assistant"; call: ToolCall };
106-
107-/** A position in a thread's `messages`. Branded because it is an identifier -
108- * half of the `(thread, index)` address an interaction and a citation are
109- * written as - and only ever produced by reading a real position. */
110:export type MessageIdx = number & { readonly __brand: "MessageIdx" };
111-
112-/** Anchors index into text entries only, so everything else has no text. */
113-export function messageText(message: Message): string {
114-  return message.type === "text" ? message.text : "";
115-}
116-
117-/** A block of the assistant turn currently streaming. */
118-type PendingBlock =
119-  | { type: "text"; text: string }
120-  | {
121-      type: "tool_use";
122-      id: string;
123-      name: string;
124-      inputJson: string;
125-      input: Record<string, unknown> | undefined;
126-    };
127-
128-/** The subset of WebSocket the thread uses, so tests can stand in for it. */
129-export type Socket = {
130-  send(data: string): void;
131-  addEventListener(
132-    type: "message",
133-    listener: (e: MessageEvent<string>) => void,
134-  ): void;
135-};
--
203:export function projectLog(
204-  turns: ReadonlyArray<Anthropic.MessageParam>,
205-): ReadonlyArray<Message> {
206-  return project(turns, undefined);
207-}
208-
209-export function trimUnansweredTools(
210-  log: ReadonlyArray<Anthropic.MessageParam>,
211-): Anthropic.MessageParam[] {
212-  const out = [...log];
213-  while (out.length > 0 && !answered(out)) out.pop();
214-  return out;
215-}
216-function answered(log: ReadonlyArray<Anthropic.MessageParam>): boolean {
217-  const results = new Set<string>();
218-  for (const turn of log) {
219-    if (typeof turn.content === "string") continue;
220-    for (const block of turn.content)
221-      if (block.type === "tool_result") results.add(block.tool_use_id);
222-  }
223-  for (const turn of log) {
224-    if (typeof turn.content === "string") continue;
225-    for (const block of turn.content)
226-      if (block.type === "tool_use" && !results.has(block.id)) return false;
227-  }
228-  return true;
