$ cd ~/.claude/skills/browser && pkgx pnpm exec tsx scripts/browser.ts "
load http://localhost:5173
sleep 1500
eval
window.__errs=[]; window.addEventListener('error',e=>window.__errs.push(String(e.message)));
const g=window.__graph;
g.putNode({title:'closures',description:'d',notes:'',level:2});
g.putNode({title:'scope',description:'d',notes:'',level:3});
Array.from(document.querySelectorAll('button')).find(b=>b.textContent==='Knowledge graph').click();
await new Promise(r=>setTimeout(r,500));
return {nodes:document.querySelectorAll('[data-node]').length, errs:window.__errs, html:document.querySelector('[class^=graph_]')?.outerHTML.slice(0,400)};
endeval
"
