$ cd ~/.claude/skills/browser && pkgx pnpm exec tsx scripts/browser.ts "
load http://localhost:5173
sleep 2000
eval
const nav = document.querySelector('[class^=nav]') || document.body.firstElementChild.firstElementChild;
return Array.from(nav.children).map(e => { const r = e.getBoundingClientRect(); return { tag: e.tagName, cls: e.className, text: e.textContent.slice(0,30), display: getComputedStyle(e).display, x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.width), h: Math.round(r.height) }; });
endeval
screenshot layout.png
"
