$ cd ~/.claude/skills/browser && pkgx pnpm exec tsx scripts/browser.ts "
load http://localhost:5173
sleep 2000
eval
function d(e){const r=e.getBoundingClientRect();return {cls:e.className,x:Math.round(r.x),y:Math.round(r.y),w:Math.round(r.width),h:Math.round(r.height)}}
const app=document.body.firstElementChild.firstElementChild;
const before=Array.from(app.children).map(d);
Array.from(document.querySelectorAll('button')).find(b=>b.textContent==='Knowledge graph').click();
await new Promise(r=>setTimeout(r,300));
const graph=Array.from(app.children).map(d);
Array.from(document.querySelectorAll('button')).find(b=>b.textContent==='Threads').click();
await new Promise(r=>setTimeout(r,300));
return {before, graph, back: Array.from(app.children).map(d), errors: window.__errs};
endeval
"
