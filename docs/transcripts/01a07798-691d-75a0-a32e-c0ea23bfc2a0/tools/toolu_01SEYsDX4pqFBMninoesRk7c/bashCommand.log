$ cd ~/.claude/skills/browser && pkgx pnpm exec tsx scripts/browser.ts "
load http://localhost:5173
sleep 2000
eval
function d(e){const r=e.getBoundingClientRect();return {tag:e.tagName,cls:e.className,disp:getComputedStyle(e).display,x:Math.round(r.x),y:Math.round(r.y),w:Math.round(r.width),h:Math.round(r.height)}}
const app=document.body.firstElementChild;
return {win:[window.innerWidth,window.innerHeight],app:d(app),kids:Array.from(app.children).map(d),body:Array.from(app.children).flatMap(c=>Array.from(c.children).map(d))};
endeval
"
