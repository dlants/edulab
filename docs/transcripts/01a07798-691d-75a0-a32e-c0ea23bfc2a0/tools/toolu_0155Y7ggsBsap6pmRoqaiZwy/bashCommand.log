$ cd ~/.claude/skills/browser && pkgx pnpm exec tsx scripts/browser.ts "
load http://localhost:5173
sleep 2000
eval
const nav=document.querySelector('[class^=nav_]');
const btn=Array.from(nav.querySelectorAll('button')).find(b=>b.textContent==='?');
btn.style.display='';
nav.querySelector('[class^=build-status]').textContent='built, 6 failed';
await new Promise(r=>setTimeout(r,100));
function d(e){const r=e.getBoundingClientRect();return {t:e.textContent.slice(0,20),x:Math.round(r.x),y:Math.round(r.y),w:Math.round(r.width),h:Math.round(r.height)}}
return {nav:d(nav),kids:Array.from(nav.children).map(d)};
endeval
screenshot nav.png
