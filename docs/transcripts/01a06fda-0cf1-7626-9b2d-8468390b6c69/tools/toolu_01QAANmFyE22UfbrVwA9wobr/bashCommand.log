import path from "node:path";
import { fileURLToPath } from "node:url";
import dotenv from "dotenv";
import { createApp } from "./create-app.ts";
import { createPool } from "./db/connect.ts";
import { createConsoleSender, createResendSender } from "./email/send.ts";
import { readEnv } from "./env.ts";
import { createMessageWorker } from "./messages/worker.ts";
import { createMeili } from "./search/meili.ts";
import { createIncrementalReindexWorker } from "./search/reindex-worker.ts";
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
dotenv.config({ path: path.join(__dirname, "../../.env") });
async function run() {
  const env = readEnv();
  const pool = createPool(env.DATABASE_URL);
  const email =
    env.RELEASE_STAGE === "prod"
      ? createResendSender(env.RESEND_API_KEY, env.FROM_EMAIL)
      : createConsoleSender();
  const meili = createMeili(env);
  const app = await createApp({ pool, env, email, meili });
  // The background incremental reindex worker lives ONLY here, in the prod
  // entry point — deliberately not in `createApp`. Tests (backend vitest +
  // e2e) build the app via `createApp` and so never start it: search reindexing
  // in tests is explicit and on-demand via the org-scoped helpers
  // (`reindexOrg` / `reindexOrgIncremental`). `createApp` only `ensureLiveIndex`
  // at boot so the app starts with an empty, settings-applied live index.
  const searchWorker = createIncrementalReindexWorker(
    pool,
    meili,
    env.MEILI_INDEX_NAMESPACE,
  );
  // The email send/render worker: forms <=100-member batches from unbatched
  // pending messages, renders them, and drains them to Resend with backoff. Like
  // the search worker it lives ONLY in the prod entry point, never in
  // createApp — tests drive it explicitly via `createMessageWorker(...).drainOnce()`.
  const messageWorker = createMessageWorker(pool, email, env);
  messageWorker.start();
  searchWorker.start();
  for (const signal of ["SIGINT", "SIGTERM"] as const) {
    process.once(signal, () => {
      void Promise.all([searchWorker.stop(), messageWorker.stop()]).then(() =>
        app.close(),
      );
    });
  }
  const PORT = parseInt(process.env.PORT || "3000", 10);
  await app.listen({ port: PORT, host: "0.0.0.0" });
  console.log(`gatherus running on port ${PORT}`);
}
run().catch((err) => {
  console.error(err);
  process.exit(1);
});
