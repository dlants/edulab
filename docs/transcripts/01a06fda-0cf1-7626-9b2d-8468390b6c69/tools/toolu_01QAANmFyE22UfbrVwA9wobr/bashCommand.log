import { registerImports } from "./imports/routes.ts";
import { registerMessageTemplates } from "./message-templates/routes.ts";
import { registerMessages } from "./messages/routes.ts";
import { registerMessageWebhook } from "./messages/webhook.ts";
import { registerOrgInvitations } from "./org-invitations/routes.ts";
import { registerOrganizations } from "./organizations/routes.ts";
import { installPermissionErrorHandler } from "./permissions/plugin.ts";
import { registerPersonGroups } from "./person-groups/routes.ts";
import { registerPersons } from "./persons/routes.ts";
import { registerRosters } from "./rosters/routes.ts";
import { registerSearch } from "./search/routes.ts";
