export async function createApp({
  pool,
  env,
  email,
  meili,
}: {
  pool: pg.Pool;
  env: AppEnv;
  email: EmailSender;
  meili: Meilisearch;
}) {
  // 6 MiB leaves headroom above the person-import CSV cap (5 MiB, enforced in
  // the handler with a clear 400) so oversized imports get a useful error rather
  // than a bare 413.
  const app = Fastify({ trustProxy: true, bodyLimit: 6 * 1024 * 1024 });
  await app.register(cookie);
  installPermissionErrorHandler(app);
  app.post("/api/health", async () => ({ ok: true }));
  const auth = createAuth({ pool, env, email });
  await registerAuth(app, auth);
  app.decorate("auth", auth);
  await registerAccount(app);
  await registerPersons(app, pool);
  await registerEvents(app, pool);
  await registerAppointments(app, pool);
  await registerAttendance(app, pool);
  await registerEventGroups(app, pool);
  await registerRosters(app, pool);
  await registerPersonGroups(app, pool);
  await registerOrganizations(app, pool);
  await registerOrgInvitations(app, pool, email, env);
  await registerSurveyTemplates(app, pool);
  await registerMessageTemplates(app, pool);
  await registerMessages(app, pool);
  await registerSurveyInstances(
    app,
    pool,
    email,
    env,
    meili,
    env.MEILI_INDEX_NAMESPACE,
  );
  await registerSurveyInstancesPublic(app, pool);
  await registerCalendars(app, pool);
  await registerCalendarsPublic(app, pool, email, env);
  await registerMessageWebhook(app, pool, env);
  await registerSearch(app, pool, meili, env.MEILI_INDEX_NAMESPACE);
  await registerTags(app, pool);
  await registerServices(app, pool);
  await registerImports(app, pool);
  await registerSheets(app, pool);
  return app;
}
