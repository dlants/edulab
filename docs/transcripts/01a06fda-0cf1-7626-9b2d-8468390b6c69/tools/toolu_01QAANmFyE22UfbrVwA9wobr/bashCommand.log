  GOOGLE_CLIENT_SECRET: string;
  RESEND_API_KEY: string;
  FROM_EMAIL: string;
  RESEND_WEBHOOK_SECRET: string;
  MEILI_URL: string;
  MEILI_MASTER_KEY: string;
  MEILI_INDEX_NAMESPACE: MeiliNamespace;
};
export function readEnv(): AppEnv {
  const RELEASE_STAGE = requireEnv("RELEASE_STAGE");
  if (RELEASE_STAGE !== "prod" && RELEASE_STAGE !== "dev") {
    throw new Error(`RELEASE_STAGE must be prod | dev, got ${RELEASE_STAGE}`);
  }
  return {
    RELEASE_STAGE,
    DATABASE_URL: requireEnv("DATABASE_URL"),
    BASE_URL: requireEnv("BASE_URL"),
    BETTER_AUTH_SECRET: requireEnv("BETTER_AUTH_SECRET"),
    BETTER_AUTH_URL: requireEnv("BETTER_AUTH_URL"),
    GOOGLE_CLIENT_ID: requireEnv("GOOGLE_CLIENT_ID"),
    GOOGLE_CLIENT_SECRET: requireEnv("GOOGLE_CLIENT_SECRET"),
    RESEND_API_KEY: requireEnv("RESEND_API_KEY"),
    FROM_EMAIL: requireEnv("FROM_EMAIL"),
    RESEND_WEBHOOK_SECRET: requireEnv("RESEND_WEBHOOK_SECRET"),
    MEILI_URL: requireEnv("MEILI_URL"),
    MEILI_MASTER_KEY: requireEnv("MEILI_MASTER_KEY"),
    MEILI_INDEX_NAMESPACE: (process.env.MEILI_INDEX_NAMESPACE ??
      "") as MeiliNamespace,
  };
}
function requireEnv(name: string): string {
  const value = process.env[name];
  if (!value) throw new Error(`Missing required env var: ${name}`);
  return value;
}
/**
 * The transport. One socket per tab, carrying both directions: the client's
 * view changes and commands go up, frames come down. They share one ordered
 * path to one process, which is what makes sheet-affinity a routing decision
 * rather than a distributed-systems one — a command that committed anywhere
 * else would never reach this process's bus.
 */
import type { ServerFrame, UserId } from "@gatherus/iso/types.ts";
import websocket from "@fastify/websocket";
import type { FastifyInstance } from "fastify";
import type pg from "pg";
import type { Auth } from "../auth/setup.ts";
import { getSession } from "../auth/setup.ts";
import type { PermissionContext } from "../permissions/context.ts";
import { ForbiddenError } from "../permissions/errors.ts";
import { loadPermissionContext } from "../permissions/load.ts";
import type { Bus } from "./bus.ts";
import { parseClientMessage } from "./parse.ts";
import type { SheetTokens } from "./state.ts";
import { SheetSession } from "./session.ts";
/** A peer that vanished without a FIN holds a session and its window, so the
 * interval is the session-leak window. Correctness does not depend on it. */
const HEARTBEAT_MS = 15_000;
function sheetTokens(ctx: PermissionContext): SheetTokens {
  const descriptor = { kind: "sheet", orgId: ctx.orgId } as const;
  return {
    read: ctx.require("sheet:read", descriptor),
    write: ctx.require("sheet:write", descriptor),
    // schema authority is optional: a data-entry role opens the same socket
    // and is refused only for the commands that carry a column op.
    manage: (() => {
      try {
        return ctx.require("sheet:manage", descriptor);
      } catch (err) {
        if (err instanceof ForbiddenError) return null;
        throw err;
      }
    })(),
  };
}
export async function registerSheetSocket(
  app: FastifyInstance,
  pool: pg.Pool,
  bus: Bus,
) {
  const auth: Auth = app.auth;
  await app.register(websocket);
  app.get("/api/sheets/socket", { websocket: true }, async (socket, req) => {
    // the listener is attached before the first await: `ws` discards data
    // frames that arrive with no `message` listener, and a real client sends
    // its `setView` the instant the socket opens.
    const buffered: Buffer[] = [];
    let deliver = (data: Buffer) => {
      buffered.push(data);
    };
    socket.on("message", (data: Buffer) => deliver(data));
    const authed = await getSession(req, auth);
    if (!authed) return socket.close(4401, "unauthorized");
    const ctx = await loadPermissionContext(pool, authed.user.id as UserId);
    if (!ctx) return socket.close(4403, "forbidden");
    let tokens: SheetTokens;
    try {
      tokens = sheetTokens(ctx);
    } catch (err) {
      if (err instanceof ForbiddenError) return socket.close(4403, "forbidden");
      throw err;
    }
    const session = new SheetSession(
      pool,
      {
        orgId: ctx.orgId,
        actor: { kind: "user", userId: ctx.userId },
        tokens,
        bus,
      },
      {
        send: (frame: ServerFrame) => socket.send(JSON.stringify(frame)),
        close: (reason) => socket.close(4000, reason),
      },
    );
    let alive = true;
    const heartbeat = setInterval(() => {
      if (!alive) {
        socket.terminate();
        return;
      }
      alive = false;
      socket.ping();
    }, HEARTBEAT_MS);
    socket.on("pong", () => {
      alive = true;
    });
    deliver = (data: Buffer) => {
      try {
        session.receive(parseClientMessage(JSON.parse(data.toString())));
      } catch {
        socket.close(4400, "bad_request");
      }
    };
    for (const data of buffered.splice(0)) deliver(data);
    socket.on("close", () => {
      clearInterval(heartbeat);
      session.close();
    });
  });
}
