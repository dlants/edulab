      }
      const ps = expectPage(state, "search", "SEARCH_MSG");
      if (!ps) break;
      searchUpdate(
        ps.state,
        msg.msg,
        (m) => dispatch({ type: "SEARCH_MSG", msg: m }),
        {
          eventStore: ctx.eventStore,
          eventGroupStore: ctx.eventGroupStore,
          rosterStore: ctx.rosterStore,
          personGroupStore: ctx.personGroupStore,
          nameStore: ctx.nameStore,
          searchStore: ctx.searchStore,
          tagStore: ctx.tagStore,
          surveyTemplateStore: ctx.surveyTemplateStore,
          matchPrefs: ctx.matchPrefs,
          mainDispatch: dispatch,
          postRenderBus: ctx.postRenderBus,
          dismissStack: ctx.dismissStack,
        },
      );
      // Reflect the drawer's open/closed entity in the URL (its own history
      // entry, like every other structural search-param change), so
      // back/forward opens and closes it.
      if (msg.msg.type === "VIEW_DETAIL" || msg.msg.type === "CLOSE_DRAWER") {
        const params = { ...ctx.searchStore.getState().params };
        if (ps.state.entityDetail)
          params.select = refKey(ps.state.entityDetail.ref);
        else delete params.select;
        ctx.router.update({
          type: "NAVIGATE",
          route: { page: "search", params },
          kind: "push",
        });
