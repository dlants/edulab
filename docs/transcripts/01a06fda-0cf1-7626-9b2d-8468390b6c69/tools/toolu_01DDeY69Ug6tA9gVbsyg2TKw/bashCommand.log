      // new week's events are about to render; scroll the grid to the earliest
      // one so evening-only weeks aren't off the bottom of the viewport. Every
      // filter toggle, query edit, and week navigation funnels through this OK.
      if (msg.msg.type === "OK" && state.pageState.page === "calendar") {
