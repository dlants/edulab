function searchUrlWriteKind(
  type: SearchStoreMsg["type"],
): "push" | "replace" | null {
  switch (type) {
    case "SET_QUERY":
      return "replace";
    case "SELECT_FACET":
    case "SET_FACET_VALUES":
    case "SET_RANGE":
    case "SET_CUSTOM_TEXT":
    case "SET_SORT":
    case "SET_SORT_DIR":
    case "TOGGLE_DIR":
    case "NEXT_PAGE":
    case "PREV_PAGE":
      return "push";
    case "RESET":
    case "REFRESH":
    case "OK":
    case "ERR":
    case "NEXT_EVENT_OK":
      return null;
  }
}
function pageStateFor(route: Route, auth: Auth): PageState {
  if (route.page === "public-calendar") {
    return {
      page: "public-calendar",
      state: publicCalendarState(route.slug as PublicSlug),
    };
  }
  if (route.page === "reservation-redeem") {
    return {
      page: "reservation-redeem",
      state: reservationRedeemState(route.token, route.orgSlug),
    };
  }
  if (route.page === "public-survey") {
    return {
      page: "public-survey",
      state: publicSurveyState(route.slug as PublicSlug),
    };
  }
  if (route.page === "accept-invite") {
    return {
      page: "accept-invite",
      state: acceptInviteState(route.token),
    };
  }
  // Neutral root `/`: only ever reached here while anonymous — a signed-in user
  // is dispatched to /me or their org back-office at the RouterController. Render
  // the marketing homepage (login CTA).
  if (route.page === "home") {
    return { page: "marketing" };
  }
  if (auth.status === "anonymous" || route.page === "login") {
    return { page: "login" };
  }
  if (route.page === "me") {
    return { page: "me", state: meHomeState() };
  }
  // "Become an organizer": the explicit create-org action, reachable by any
  // signed-in user under /me/new-org.
  if (route.page === "new-org") {
    return { page: "create-org", state: createOrgState() };
  }
  // Back-office route: requires membership in the org named by <orgSlug>. A
  // logged-in non-member (a client, or a member of a *different* org) gets the
  // permission-denied render state — never a redirect, since they ARE signed in.
  const activeOrg = resolveActiveOrg(auth.me, getCurrentOrgSlug() ?? undefined);
  if (activeOrg === null) {
    return { page: "permission-denied", state: permissionDeniedState() };
  }
  const orgId = activeOrg.id;
  switch (route.page) {
    case "dashboard":
      return { page: "home" };
    case "search":
      return {
        page: "search",
        state: searchState(
          orgId,
          route.params.query,
          activeOrg.person_custom_fields_template_id,
          activeOrg,
          auth.me.user.id,
          route.params.select ?? null,
        ),
      };
    case "calendar": {
      const { canRead, canWrite } = customFieldsPermissions(
        activeOrg,
        auth.me.user.id,
      );
      const canApplyTags = tagsCanApply(activeOrg, auth.me.user.id);
      return {
        page: "calendar",
        state: calendarState(
          orgId,
          route.params.startsFrom ?? 0,
          route.params.query,
          activeOrg.person_custom_fields_template_id,
          canRead,
          canWrite,
          canApplyTags,
          parseRefKey(route.params.select ?? null),
        ),
      };
    }
    case "person":
      return {
        page: "person",
        state: personDetailState(
          route.id as PersonId,
          auth.me.organizations.find((o) => o.id === orgId) ?? null,
          auth.me.user.id,
        ),
      };
    case "organization":
      return { page: "organization", state: organizationState() };
    case "account":
      return { page: "account", state: accountState() };
    case "import":
      return {
        page: "import",
        state: importState(
          activeOrg.person_custom_fields_template_id,
          orgId,
          auth.me.user.email === DEMO_EMAIL,
        ),
      };
    case "survey-edit":
      return {
        page: "survey-edit",
        state: surveyBuilderState(route.id as SurveyTemplateId),
      };
    case "message-template-edit":
      return {
        page: "message-template-edit",
        state: messageTemplateBuilderState(route.id as MessageTemplateId),
      };
    case "message-campaigns":
      return {
        page: "message-campaigns",
        state: messageCampaignsState(),
      };
    case "person-custom-fields":
      return {
        page: "person-custom-fields",
        state: surveyBuilderState(
          activeOrg.person_custom_fields_template_id,
          "custom-fields",
        ),
      };
    case "kiosk":
      return {
        page: "kiosk",
        state: kioskState(
          route.source === "event"
            ? { kind: "event", id: route.id as EventId }
            : { kind: "instance", id: route.id as SurveyInstanceId },
        ),
      };
    default:
      return assertNever(route);
  }
}
function crumbsForPage(ps: PageState): Crumb[] {
  switch (ps.page) {
    case "home":
    case "marketing":
    case "login":
    case "me":
    case "create-org":
    case "permission-denied":
    case "search":
    case "calendar":
    case "account":
    case "organization":
    case "public-survey":
    case "public-calendar":
    case "reservation-redeem":
    case "accept-invite":
      return [];
    case "person":
      return personDetailGetCrumbs(ps.state);
    case "message-template-edit":
      return [{ label: "message templates" }, { label: "edit" }];
    case "message-campaigns":
      return [{ label: "campaigns" }];
    case "survey-edit":
      return surveyBuilderGetCrumbs(ps.state);
    case "import":
      return [
        {
          label: "organization",
          href: routeToPath({ page: "organization" }),
        },
        { label: "import" },
      ];
    case "person-custom-fields":
      return [
        {
          label: "organization",
          href: routeToPath({ page: "organization" }),
        },
        { label: "custom fields" },
      ];
    case "kiosk":
      return [];
    default:
      return assertNever(ps);
  }
}
function navSection(route: Route): string | null {
  switch (route.page) {
    case "home":
    case "dashboard":
      return "home";
    case "me":
      return null;
    case "calendar":
      return "calendar";
    case "search":
    case "survey-edit":
    case "person":
      return "search";
    case "organization":
    case "person-custom-fields":
    case "import":
      return "organization";
    default:
      return null;
  }
}
// Back-office nav chrome shows only on the org back-office surface
// (`/org/<orgSlug>/*`), and never on the full-screen kiosk. The front-office,
// the personal surface, and the neutral root/marketing page render chrome-free.
function navHidden(route: Route, auth: Auth): boolean {
  return (
    routeKind(route) !== "back-office" ||
    route.page === "kiosk" ||
    auth.status === "anonymous"
  );
}
// Derive the shared header bar's contents from the current route + auth, or
// `undefined` to render no header at all (the full-screen kiosk, the login
// page, and the public front-office stay chrome-free). The three live modes
// map onto the three surfaces: anonymous root -> "anonymous", `/me` ->,
// "personal", the org back-office -> "back-office".
function headerStateFor(route: Route, auth: Auth): HeaderState | undefined {
  if (route.page === "kiosk" || route.page === "login") return undefined;
  if (routeKind(route) === "front-office") return undefined;
  if (auth.status === "anonymous") {
    return {
      mode: "anonymous",
      navSection: null,
      email: null,
      orgs: [],
      activeOrgId: null,
    };
  }
  const orgs = auth.me.organizations.map((o) => ({ id: o.id, name: o.name }));
  const active = resolveActiveOrg(auth.me, getCurrentOrgSlug() ?? undefined);
  return {
    mode: routeKind(route) === "back-office" ? "back-office" : "personal",
    navSection: navSection(route),
    email: auth.me.user.email,
    orgs,
    activeOrgId: active ? active.id : null,
  };
}
function expectPage<T extends PageState["page"]>(
  state: MainState,
  page: T,
  msgType: string,
): (PageState & { page: T }) | null {
  if (state.pageState.page !== page) {
    console.warn(
      `dropped ${msgType} for non-${page} page (current: ${state.pageState.page})`,
    );
    return null;
  }
  return state.pageState as PageState & { page: T };
}
// Apply a route transition to the live state. Kept dispatch-free so it can be
// called both from the NAVIGATE message and synchronously from other reducer
// branches (e.g. the calendar's next-event jump) without re-entering dispatch.
// Commit a navigation: the controller resolves auth redirects and owns the new
// route; here we derive the matching page state and (re)seed the shared search
// store for the search/calendar views.
function applyNavigate(
  state: MainState,
  route: Route,
  ctx: AppCtx,
  dispatch: (m: MainMsg) => void,
): void {
  const next = ctx.router.update({ type: "NAVIGATE", route });
  state.pageState = pageStateFor(next, ctx.auth.get());
  if (next.page === "search" || next.page === "calendar") {
    ctx.searchStore.update({ type: "RESET", params: next.params }, (m) =>
      dispatch({ type: "SEARCH_STORE_MSG", msg: m }),
    );
  }
}
function update(
  state: MainState,
  msg: MainMsg,
  ctx: AppCtx,
  dispatch: (m: MainMsg) => void,
): void {
  switch (msg.type) {
    case "NAVIGATE": {
      applyNavigate(state, msg.route, ctx, dispatch);
      break;
    }
    case "SELECT_ORG": {
      // The org switcher is a navigate control: remember the choice, point the
      // active back-office slug at the new org, and re-navigate the current
      // route so the URL's <orgSlug> segment updates.
      ctx.auth.rememberOrg(msg.orgId);
      const auth = ctx.auth.get();
      if (auth.status !== "anonymous") {
        const org = auth.me.organizations.find((o) => o.id === msg.orgId);
        if (org) setCurrentOrgSlug(org.slug);
      }
      applyNavigate(state, ctx.router.route, ctx, dispatch);
      break;
    }
    case "SIGN_OUT":
      api("/api/auth/sign-out", {})
        .catch(() => {})
        .finally(() => {
          clearLastOrg();
          setCurrentOrgSlug(null);
          window.location.href = "/login";
        });
      break;
    case "SURVEY_TEMPLATE_STORE_MSG":
      ctx.surveyTemplateStore.update(msg.msg);
      break;
    case "RESPONSE_STORE_MSG":
      ctx.responseStore.update(msg.msg);
      break;
    case "EVENT_GROUP_STORE_MSG":
      ctx.eventGroupStore.update(msg.msg);
      break;
    case "ROSTER_STORE_MSG":
      ctx.rosterStore.update(msg.msg);
      break;
    case "TAG_STORE_MSG":
      ctx.tagStore.update(msg.msg);
      break;
    case "PERSON_GROUP_STORE_MSG":
      ctx.personGroupStore.update(msg.msg);
      break;
    case "NAME_STORE_MSG":
      ctx.nameStore.update(msg.msg);
      break;
    case "ACCEPT_INVITE_MSG": {
      const ps = expectPage(state, "accept-invite", "ACCEPT_INVITE_MSG");
      if (!ps) break;
      acceptInviteUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "ACCEPT_INVITE_MSG", msg: m }),
      );
      break;
    }
    case "PERSON_DETAIL_MSG": {
      const ps = expectPage(state, "person", "PERSON_DETAIL_MSG");
      if (!ps) break;
      personDetailUpdate(
        ps.state,
        msg.msg,
        (m) => dispatch({ type: "PERSON_DETAIL_MSG", msg: m }),
        {
          surveyTemplateStore: ctx.surveyTemplateStore,
          dismissStack: ctx.dismissStack,
        },
      );
      break;
    }
    case "CREATE_ORG_MSG": {
      const ps = expectPage(state, "create-org", "CREATE_ORG_MSG");
      if (!ps) break;
      createOrgUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "CREATE_ORG_MSG", msg: m }),
      );
      break;
    }
    case "KIOSK_MSG": {
      const ps = expectPage(state, "kiosk", "KIOSK_MSG");
      if (!ps) break;
      kioskUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "KIOSK_MSG", msg: m }),
      );
      break;
    }
    case "IMPORT_MSG": {
      const ps = expectPage(state, "import", "IMPORT_MSG");
      if (!ps) break;
      importUpdate(
        ps.state,
        msg.msg,
        (m) => dispatch({ type: "IMPORT_MSG", msg: m }),
        { surveyTemplateStore: ctx.surveyTemplateStore },
      );
      break;
    }
    case "ACCOUNT_MSG": {
      const ps = expectPage(state, "account", "ACCOUNT_MSG");
      if (!ps) break;
      accountUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "ACCOUNT_MSG", msg: m }),
      );
      break;
    }
    case "ORGANIZATION_MSG": {
      const ps = expectPage(state, "organization", "ORGANIZATION_MSG");
      if (!ps) break;
      organizationUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "ORGANIZATION_MSG", msg: m }),
      );
      break;
    }
    case "PUBLIC_SURVEY_MSG": {
      const ps = expectPage(state, "public-survey", "PUBLIC_SURVEY_MSG");
      if (!ps) break;
      publicSurveyUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "PUBLIC_SURVEY_MSG", msg: m }),
      );
      break;
    }
    case "PUBLIC_CALENDAR_MSG": {
      const ps = expectPage(state, "public-calendar", "PUBLIC_CALENDAR_MSG");
      if (!ps) break;
      publicCalendarUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "PUBLIC_CALENDAR_MSG", msg: m }),
      );
      break;
    }
    case "RESERVATION_REDEEM_MSG": {
      const ps = expectPage(
        state,
        "reservation-redeem",
        "RESERVATION_REDEEM_MSG",
      );
      if (!ps) break;
      reservationRedeemUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "RESERVATION_REDEEM_MSG", msg: m }),
      );
      break;
    }
    case "EMAIL_TEMPLATE_BUILDER_MSG": {
      const ps = expectPage(
        state,
        "message-template-edit",
        "EMAIL_TEMPLATE_BUILDER_MSG",
      );
      if (!ps) break;
      messageTemplateBuilderUpdate(
        ps.state,
        msg.msg,
        (m) => dispatch({ type: "EMAIL_TEMPLATE_BUILDER_MSG", msg: m }),
        { mainDispatch: dispatch },
      );
      break;
    }
    case "EMAIL_CAMPAIGNS_MSG": {
      const ps = expectPage(state, "message-campaigns", "EMAIL_CAMPAIGNS_MSG");
      if (!ps) break;
      messageCampaignsUpdate(ps.state, msg.msg, (m) =>
        dispatch({ type: "EMAIL_CAMPAIGNS_MSG", msg: m }),
      );
      break;
    }
    case "SURVEY_BUILDER_MSG": {
      const page = state.pageState;
      if (page.page !== "survey-edit" && page.page !== "person-custom-fields") {
        console.warn(
          `dropped SURVEY_BUILDER_MSG for non-builder page (current: ${page.page})`,
        );
        break;
      }
      surveyBuilderUpdate(
        page.state,
        msg.msg,
        (m) => dispatch({ type: "SURVEY_BUILDER_MSG", msg: m }),
        { mainDispatch: dispatch },
      );
      break;
    }
    case "CALENDAR_MSG": {
      // The calendar shares the SearchStore; its store actions are applied at
      // the root so async results re-enter through SEARCH_STORE_MSG. Week
      // navigation is plain `<a>` links handled by NAVIGATE, so the only store
      // action here is the debounced query commit / facet toggle.
      if (msg.msg.type === "STORE" || msg.msg.type === "SEARCH_STORE") {
        ctx.searchStore.update(msg.msg.msg, (m) =>
          dispatch({ type: "SEARCH_STORE_MSG", msg: m }),
        );
        break;
      }
      if (msg.msg.type === "GOTO_WEEK") {
        // Week navigation from the shared WeekPagerView. Like next-event, it's a
        // route write that carries the live query + the user's facet filters
        // (minus the locked type), keeping the calendar's URL-driven model.
        const params = ctx.searchStore.getState().params;
        const userFacets = { ...params.facetFilters };
        delete userFacets.type;
        const route: Route = {
          page: "calendar",
          params: calendarSeedParams(
            msg.msg.weekStart,
            params.query,
            userFacets,
          ),
        };
        applyNavigate(state, route, ctx, dispatch);
        break;
      }
      if (msg.msg.type === "GOTO_NEXT_EVENT") {
        // The store caches the next event's start time per query-shape, so the
        // jump is a pure state read — no round-trip on click. Jump the calendar
        // to that event's week, carrying the live query + the user's facet
        // filters (minus the locked type).
        const next = ctx.searchStore.getNextEventStarts();
        if (next === null) break;
        const params = ctx.searchStore.getState().params;
        const userFacets = { ...params.facetFilters };
        delete userFacets.type;
        const route: Route = {
          page: "calendar",
          params: calendarSeedParams(
            weekStartMs(new Date(next)),
            params.query,
            userFacets,
          ),
        };
        applyNavigate(state, route, ctx, dispatch);
        break;
      }
      const cps = expectPage(state, "calendar", "CALENDAR_MSG");
      if (!cps) break;
      calendarUpdate(
        cps.state,
        msg.msg,
        (m) => dispatch({ type: "CALENDAR_MSG", msg: m }),
        {
          searchStore: ctx.searchStore,
          matchPrefs: ctx.matchPrefs,
          nameStore: ctx.nameStore,
          eventStore: ctx.eventStore,
          eventGroupStore: ctx.eventGroupStore,
          rosterStore: ctx.rosterStore,
          surveyTemplateStore: ctx.surveyTemplateStore,
          postRenderBus: ctx.postRenderBus,
          dismissStack: ctx.dismissStack,
        },
      );
      // Reflect the drawer's open/closed entity in the URL (its own history
      // entry, like every other structural search-param change), so
      // back/forward opens and closes it.
      if (msg.msg.type === "VIEW_DETAIL" || msg.msg.type === "CLOSE_DRAWER") {
        const params = { ...ctx.searchStore.getState().params };
        if (cps.state.entityDetail)
          params.select = refKey(cps.state.entityDetail.ref);
        else delete params.select;
        ctx.router.update({
          type: "NAVIGATE",
          route: { page: "calendar", params },
          kind: "push",
        });
      }
      break;
    }
    case "SEARCH_MSG": {
      // Store-bound actions are driven from the root so async results re-enter
      // through SEARCH_STORE_MSG regardless of which page is mounted.
      if (msg.msg.type === "SEARCH_STORE") {
        const inner = msg.msg.msg;
        ctx.searchStore.update(inner, (m) =>
