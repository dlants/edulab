      );
    case "survey-edit":
      return show(
        SurveyBuilderPage,
        ps.state,
        { mainDispatch: dispatch },
        (m) => dispatch({ type: "SURVEY_BUILDER_MSG", msg: m }),
      );
    case "person-custom-fields":
      return show(
        SurveyBuilderPage,
        ps.state,
        { mainDispatch: dispatch },
        (m) => dispatch({ type: "SURVEY_BUILDER_MSG", msg: m }),
      );
    case "kiosk":
      return show(KioskPage, ps.state, empty, (m) =>
        dispatch({ type: "KIOSK_MSG", msg: m }),
      );
    case "public-survey":
      return show(PublicSurveyPage, ps.state, empty, (m) =>
        dispatch({ type: "PUBLIC_SURVEY_MSG", msg: m }),
