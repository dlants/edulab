}
class MainView implements View<MainState, MainMsg, AppCtx> {
  container: HTMLElement;
  private b: Binder<MainState>;
  private ctx: AppCtx;
  constructor(
    container: HTMLElement,
    dispatch: (msg: MainMsg) => void,
    initialState: MainState,
    ctx: AppCtx,
  ) {
    this.container = container;
    this.ctx = ctx;
    const headerRef = ref("header");
    const crumbsRef = ref("crumbs");
    const mainRef = ref("main");
    container.innerHTML = sanitize`
      <div class="${rootClass}">
        <div data-ref="${headerRef}"></div>
        <div data-ref="${crumbsRef}"></div>
        <main data-ref="${mainRef}"></main>
      </div>
    `;
    this.b = new Binder(container, initialState);
    this.b.bindSlot(headerRef, (): SlotContent | undefined => {
      const header = headerStateFor(this.ctx.router.route, this.ctx.auth.get());
      return header === undefined
        ? undefined
        : show(
            AppHeaderView,
            header,
            { dismissStack: this.ctx.dismissStack },
            (m) => dispatch(m),
          );
    });
    this.b.bindSlot(crumbsRef, (s) =>
      navHidden(this.ctx.router.route, this.ctx.auth.get())
        ? undefined
        : show(
            BreadcrumbsView,
            { crumbs: crumbsForPage(s.pageState) },
            {},
            noop,
          ),
    );
    this.b.bindStyle(
      mainRef,
      (): Record<string, string> =>
        navHidden(this.ctx.router.route, this.ctx.auth.get())
          ? { padding: "0" }
          : {},
    );
    // Most pages render inside the centered reading column; full-bleed shells
    // (the calendar's three-pane layout) and the nav-hidden public pages opt out.
    this.b.bindClass(mainRef, (s) =>
      navHidden(this.ctx.router.route, this.ctx.auth.get()) ||
      s.pageState.page === "calendar" ||
      s.pageState.page === "search"
        ? ""
        : centeredColumn,
    );
    this.b.bindSlot(mainRef, (s) => pageSlot(s, this.ctx, dispatch));
  }
  sync(state: MainState): void {
    this.b.sync(state);
  }
  destroy(): void {
    this.b.cleanup();
    this.container.innerHTML = "";
  }
}
async function startApp(container: HTMLElement) {
  const initialRoute = currentRoute();
